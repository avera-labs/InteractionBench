# ── InteractionBench — environment ───────────────────────────────────────────
# Copy this file to `.env` and fill in only the keys you need.
# `.env` is gitignored — never commit real keys.

# ── Gemini ───────────────────────────────────────────────────────────────────
# Content judge (content_judge.py; grade_interaction.py; the dashboard's
# the "grade content with Gemini" toggle and logic_puzzle). Needed to grade with --gemini.
GEMINI_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# The GPT-Realtime model in the /live dashboard (live_ws.py), the halfduplex
# baseline's brain (gpt-4o-mini, halfduplex.py), AND run_text_interaction.py when a
# model id has no "/" (e.g. gpt-4o-mini) — those go direct to OpenAI.
OPENAI_API_KEY=

# ── OpenRouter ───────────────────────────────────────────────────────────────
# run_text_interaction.py routes any model id with a "/" (qwen/…, deepseek/…,
# openai/gpt-5…, etc.) through OpenRouter — one key for the whole text-model IQ test.
# Get it at https://openrouter.ai and add credit. Pick exact ids at openrouter.ai/models.
OPENROUTER_API_KEY=

# ── MiMo  (official api.xiaomimimo.com, `api-key` header — NOT Bearer) ────────
# MiMo sk- tokens. The same token works for both uses if the account has balance
# for each service; keep them split so you can use different tokens if needed.
#
# TTS synthesis — dashboard /api/tts, every scenario generator (gen_keyword_wait /
# gen_stay_quiet / gen_volume_whisper / gen_interaction_tts / gen_grammar_correction)
# and the halfduplex baseline's voice.
MIMO_TTS_TOKEN=
# LLM ground-truth labeling — gen_benchmark.py calls model `mimo-v2.5-pro` on the
# official API (needs LLM credit on the account). Also the default key for the
# standalone generate_tts_mimo.py CLI. Only needed to (re)generate benchmark.json;
# running + grading existing items does NOT need it.
MIMO_API_KEY=

# ── Dashboard server (optional; have defaults) ───────────────────────────────
# HOST=127.0.0.1             # dashboard/server.py bind host  (default 127.0.0.1)
# PORT=8770                  # dashboard/server.py port       (default 8770)

# ── NOT env vars ─────────────────────────────────────────────────────────────
# The dashboard's live TTS token lanes (sg_api_lanes.json) and S3 benchmark loading
# additionally need files + backend modules from the sibling ConversationalVoice
# project. The OFFLINE GRADER needs none of this.
